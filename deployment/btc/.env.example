# Instance BTC — copy thành deployment/btc/.env rồi điền. KHÔNG commit .env. Chỉ TÊN biến + mô tả ở đây.
# Dựng: docker compose -f deployment/btc/docker-compose.yml --env-file deployment/btc/.env up -d --build
APP_ENV=production            # cookie Secure + log JSON; cần COOKIE_SECURE=false khi xem qua http trong LAN
INSTRUMENTS=BTCUSDT           # instance chỉ BTC (không chạy luồng vàng)
POSTGRES_PASSWORD=            # bắt buộc — mật khẩu user goldpulse của container db BTC
DATABASE_URL=                 # bắt buộc — postgresql+asyncpg://goldpulse:<POSTGRES_PASSWORD>@db:5432/goldpulse_btc
OPS_ACCESS_KEY=               # bắt buộc — khoá ≥ 16 ký tự, KHÁC khoá của vàng
COOKIE_SECURE=false           # http trong LAN
WEB_BIND=0.0.0.0              # 0.0.0.0 để điện thoại cùng LAN vào (cổng 8081); bỏ dòng này nếu chỉ xem trên máy
# TELEGRAM_BTC_BOT_TOKEN=     # bot Telegram RIÊNG cho BTC (@BotFather) — trống = không gửi
# TELEGRAM_BTC_CHAT_ID=       # tuỳ chọn — trống thì lấy chat đầu tiên nhắn bot
# BINANCE_BASE_URL=           # tuỳ chọn — đổi sang https://api1.binance.com nếu api.binance.com bị chặn
# BTC_POLL_SECONDS=           # tuỳ chọn, mặc định 10
