# GoldPulse — biến môi trường
#
# Copy thành deployment/local/.env rồi điền giá trị thật. KHÔNG commit .env.
# File này chỉ có TÊN biến + mô tả, không bao giờ có giá trị thật — nó là file env
# DUY NHẤT được commit (.gitignore chặn .env và .env.* ở mọi cấp).
# `make doctor` đọc file này để biết biến nào bắt buộc
# khi đặt biến trên PaaS. Quy ước thư mục: deployment/README.md.
#
# Đa target (đường intake): MỘT danh sách cho cả hệ. Biến của riêng một target thì ghi
# rõ target ở cuối dòng mô tả, và khai cùng cột "Target" trong context/TECHSTACK.md §6.

# --- Ứng dụng ---
APP_ENV=development           # development | production
APP_URL=http://localhost:3000 # URL gốc, dùng cho redirect và link trong email

# --- Database ---
DATABASE_URL=                 # chuỗi kết nối Postgres

# --- Auth (điền theo provider đã chốt ở PRD §7) ---
# AUTH_PROVIDER_KEY=
# AUTH_PROVIDER_SECRET=

# --- Error tracking (nhóm 1 production-ready) ---
# SENTRY_DSN=

# --- Analytics (nhóm 4 production-ready) ---
# ANALYTICS_KEY=

# --- Dịch vụ ngoài ---
# (thêm theo ARCHITECTURE.md §9)
