# GoldPulse — biến môi trường
#
# Copy thành deployment/local/.env rồi điền giá trị thật. KHÔNG commit .env.
# File này chỉ có TÊN biến + mô tả, không bao giờ có giá trị thật — nó là file env
# DUY NHẤT được commit (.gitignore chặn .env và .env.* ở mọi cấp).
# Biến tuỳ chọn để dạng comment — bỏ '# ' khi cần đặt (để trống sẽ làm app không lên).
# `make doctor` đọc file này để biết biến nào hợp lệ. Quy ước thư mục: deployment/README.md.

# --- Ứng dụng ---
APP_ENV=                      # development | production (production → cookie Secure, log JSON)

# --- Database ---
POSTGRES_PASSWORD=             # chỉ production (deployment/production/.env) — mật khẩu user goldpulse của container db
DATABASE_URL=                 # bắt buộc — postgresql+asyncpg://user:pass@host:5432/db

# --- Auth (PRD §7: một khoá vận hành, không tài khoản người dùng) ---
OPS_ACCESS_KEY=               # bắt buộc — khoá vào trang theo dõi; chuỗi ngẫu nhiên dài ≥ 16 ký tự

# --- Nạp dữ liệu ---
# HISTORY_START_DATE=           # tuỳ chọn, mặc định 2004-01-01
# REALTIME_POLL_SECONDS=        # tuỳ chọn, mặc định 5 — chu kỳ lấy giá gold-api.com
# WEB_BIND=                     # chỉ production — 0.0.0.0 để điện thoại cùng mạng LAN vào được; mặc định 127.0.0.1
# COOKIE_SECURE=                # tuỳ chọn — false khi xem qua http trong LAN (không có HTTPS); mặc định theo APP_ENV
# TRUST_CLOUDFLARE_IP=          # tuỳ chọn, mặc định false — CHỈ bật khi web đứng sau Cloudflare Tunnel
# BACKFILL_HOURS=               # tuỳ chọn, mặc định 24 — chu kỳ lấy bù từ HistData (đè nến tạm gold-api, lấp chỗ hở)
# DUKASCOPY_CONCURRENCY=        # tuỳ chọn, mặc định 3 — số file tải song song (Dukascopy chậm, hay trả 503)
# DUKASCOPY_DELAY_SECONDS=      # tuỳ chọn, mặc định 0.5 — nghỉ sau mỗi file
# DUKASCOPY_PROXY=              # tuỳ chọn — proxy chỉ cho worker tới Dukascopy, vd. WARP chế độ proxy socks5h://127.0.0.1:40000

# --- (v2) Não bot — tiến trình `make brain` trên máy chủ, ngoài Docker ---
# BRAIN_BACKEND=                # tuỳ chọn, mặc định cli — cli (claude -p, gói thuê bao Claude của chủ máy) | api (cần ANTHROPIC_API_KEY) | fake (chỉ test/dogfood, cấm ở production)
# CLAUDE_CLI_MODEL=             # tuỳ chọn, mặc định opus — model cho `claude -p`
# CLAUDE_CLI_EFFORT=            # tuỳ chọn, mặc định medium — low|medium|high|xhigh|max; cao hơn thì trả lời lâu hơn (xhigh ~76s/câu)
# CLAUDE_CLI_BIN=               # tuỳ chọn, mặc định claude — đường dẫn lệnh claude nếu không có trong PATH
# ANTHROPIC_API_KEY=            # chỉ khi BRAIN_BACKEND=api — chủ dự án tự dán
# CLAUDE_API_MODEL=             # tuỳ chọn, mặc định claude-opus-5
# BRAIN_TIMEOUT_SECONDS=        # tuỳ chọn, mặc định 120 — timeout một lời gọi não
# PREDICTION_HORIZON_MINUTES=   # tuỳ chọn, mặc định 15 — khung chấm dự đoán

# --- Error tracking (nhóm 1 production-ready) ---
# SENTRY_DSN=                   # tuỳ chọn
