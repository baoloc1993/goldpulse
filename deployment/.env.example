# GoldPulse — biến môi trường
#
# Copy thành deployment/local/.env rồi điền giá trị thật. KHÔNG commit .env.
# File này chỉ có TÊN biến + mô tả, không bao giờ có giá trị thật — nó là file env
# DUY NHẤT được commit (.gitignore chặn .env và .env.* ở mọi cấp).
# Biến tuỳ chọn để dạng comment — bỏ '# ' khi cần đặt (để trống sẽ làm app không lên).
# `make doctor` đọc file này để biết biến nào hợp lệ. Quy ước thư mục: deployment/README.md.

# --- Ứng dụng ---
APP_ENV=                      # development | production (production → cookie Secure, log JSON)

# --- Database ---
DATABASE_URL=                 # bắt buộc — postgresql+asyncpg://user:pass@host:5432/db

# --- Auth (PRD §7: một khoá vận hành, không tài khoản người dùng) ---
OPS_ACCESS_KEY=               # bắt buộc — khoá vào trang theo dõi; chuỗi ngẫu nhiên dài ≥ 16 ký tự

# --- Nạp dữ liệu ---
# HISTORY_START_DATE=           # tuỳ chọn, mặc định 2004-01-01
# REALTIME_POLL_SECONDS=        # tuỳ chọn, mặc định 5 — chu kỳ lấy giá gold-api.com
# DUKASCOPY_CONCURRENCY=        # tuỳ chọn, mặc định 3 — số file tải song song (Dukascopy chậm, hay trả 503)
# DUKASCOPY_DELAY_SECONDS=      # tuỳ chọn, mặc định 0.5 — nghỉ sau mỗi file
# DUKASCOPY_PROXY=              # tuỳ chọn — proxy chỉ cho worker tới Dukascopy, vd. WARP chế độ proxy socks5h://127.0.0.1:40000

# --- Error tracking (nhóm 1 production-ready) ---
# SENTRY_DSN=                   # tuỳ chọn
